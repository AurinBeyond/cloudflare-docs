    "agent": {
      "first_message": "[warmly] Hello there. I'm Elara, and I'm here to gently explore the wisdom your body holds. Let's take a moment to connect with what your body might be trying to tell you.",
      "language": "en",
      "hinglish_mode": false,
      "dynamic_variables": {
